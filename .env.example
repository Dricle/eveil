APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Encrypts user secrets (SMTP/IMAP, provider key) separately from APP_KEY (ADR-012).
CREDENTIALS_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# self|cloud. `cloud` serves the marketing homepage at /; `self` sends / straight to the app.
APP_EDITION=self
# Public sign-up, open by default. Set it to false on an instance meant for one
# team; the first account comes from the setup screen either way, and closed
# means /app/register 404s rather than showing a form that refuses.
REGISTRATION_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=eveil
DB_USERNAME=sail
DB_PASSWORD=password
# Host-side ports (shifted to avoid colliding with other local projects)
FORWARD_DB_PORT=5442
FORWARD_REDIS_PORT=6382
APP_PORT=8080

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# The app's own mail — password resets and, later, invitations. This is NOT
# the outreach sender: campaigns go out through the email accounts a user
# connects in the app. Point it at any SMTP server you already have; the dev
# stack ships Mailpit (dashboard on http://localhost:8035).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI provider (ADR-026). Anthropic is the shipped default for every agent.
ANTHROPIC_API_KEY=

# Discovery sources (ADR-006): both free, neither needs an API key.
SEARXNG_URL=http://searxng:8080
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ── Testing outreach against your own mailbox ────────────────────────────────
#
# Set this to your own address and every outreach mail goes there instead of to
# the lead. Connect a REAL mailbox in the app as usual (Settings → Mailboxes):
# the mail still leaves over its SMTP, and the reply you write still arrives in
# it over its IMAP, so the whole loop runs — only the recipient is replaced, and
# the intended one is put in the subject.
#
# Replies still attribute correctly: a reply is matched on our own Message-ID,
# never on the from-address.
OUTREACH_REDIRECT_TO=
