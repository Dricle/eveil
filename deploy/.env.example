# ── Eveil, self-hosted ────────────────────────────────────────────────────────
#
#   cp deploy/.env.example .env
#   # set the two passwords and the admin account below, then:
#   docker compose -f compose.deploy.yaml up -d
#
# Nothing here needs a third-party API key. A first discovery run works on the
# bundled SearXNG alone; an AI provider key is asked for in the app, on the
# provider screen, and stored encrypted rather than living in this file.

APP_NAME=Eveil
APP_ENV=production
APP_DEBUG=false

# Leave both empty and they are generated on first boot, into the storage volume
# (`storage/app/.keys.env`) so that every later boot reuses the same ones. Fill
# them in only if you would rather manage them yourself: anything set here wins.
#
# They are NOT interchangeable. APP_KEY encrypts cookies and sessions, so it has
# to stay rotatable after a leak; CREDENTIALS_KEY encrypts mailbox passwords and
# the provider key, and rotating that one makes every connected mailbox
# unreadable. Keeping them separate is what makes rotating either survivable.
#
# Whichever way you manage them: a database dump without the keys is worthless.
# Back them up together.
APP_KEY=
CREDENTIALS_KEY=

# The address people actually type. Used in password-reset links, so a wrong one
# sends everybody to a domain that does not exist.
APP_URL=https://eveil.example.com

# `self` sends / straight to the app. `cloud` serves a marketing homepage there,
# which a self-hosted instance has nothing to do with.
APP_EDITION=self

# Public sign-up. Closed means /app/register genuinely 404s rather than showing a
# form that refuses: the first account comes from ADMIN_* or the setup screen
# either way.
REGISTRATION_ENABLED=false

# ── The first account ────────────────────────────────────────────────────────
#
# Created once, on first boot, then never touched again: a restart cannot reset
# a password or add a second super admin. Leave the email and password empty to
# be asked on the setup screen instead, which is the better choice if the
# instance is reachable from the internet before you get to it.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ORGANIZATION=

# ── The stack ────────────────────────────────────────────────────────────────

# The port the container publishes. Put a reverse proxy in front of it for TLS: 
# the image speaks plain HTTP on purpose rather than fighting the proxy you
# already run.
APP_PORT=80

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=eveil
DB_USERNAME=eveil
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379

# Redis for all three: the queue needs it, the crawl rate limiter and the
# per-mailbox locks need it, and the cache is where settings are held.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Any random string, only used to sign SearXNG's own requests.
SEARXNG_SECRET=
SEARXNG_URL=http://searxng:8080

# ── The app's own mail ───────────────────────────────────────────────────────
#
# Password resets and, later, invitations. NOT the outreach sender: campaigns go
# out through the mailboxes connected in the app, over their own SMTP.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="eveil@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Development only. Set it to an address and EVERY outreach mail goes there
# instead of to the lead: useful for trying the real SMTP/IMAP loop against your
# own mailbox, and a silent way to reach nobody if it is left set in production.
OUTREACH_REDIRECT_TO=
