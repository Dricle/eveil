<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Self-hosted is the default the whole suite assumes (unmetered spend,
             no billing UI); `.env`'s APP_EDITION can be `cloud` for local Stripe
             work, and without this override every test would inherit that.
             Cloud-specific tests flip it back with config()->set() themselves. -->
        <env name="APP_EDITION" value="self"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- PostgreSQL in tests too (ADR-010): SQLite diverges on exactly what
             this schema leans on - JSONB, partial indexes, case sensitivity. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Agents are faked in tests, so nothing leaves the process. The key
             only has to exist: the commands refuse to run without one. -->
        <env name="ANTHROPIC_API_KEY" value="test-key"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Fortify registers the sign-up routes from config at boot, so the
             suite runs with them on and the closed case is covered by a test
             that reboots the app with the flag off. -->
        <env name="REGISTRATION_ENABLED" value="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
